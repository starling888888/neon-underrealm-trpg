{
  "name": "@neon-underrealm/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck:build && npm run wrangler:prod -- deploy --dry-run --outdir dist",
    "dev:integration": "npm run wrangler:dev -- dev src/integration-index.ts --local --persist-to .wrangler/integration-state --port 8787",
    "dev:local": "npm run wrangler:dev -- dev src/index.ts --local --persist-to .wrangler/state --port 8787",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "local:reset": "rm -rf .wrangler/state .wrangler/tmp",
    "migrate:local": "npm run wrangler:dev -- d1 migrations apply DB --local --persist-to .wrangler/state",
    "integration:reset": "rm -rf .wrangler/integration-state",
    "migrate:integration": "npm run wrangler:dev -- d1 migrations apply DB --local --persist-to .wrangler/integration-state",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:build": "tsc --noEmit --project tsconfig.build.json",
    "wrangler:dev": "./bin/wrangler.sh dev",
    "wrangler:prod": "./bin/wrangler.sh prod"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^26.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "hono": "^4.13.4",
    "jose": "^6.2.10"
  }
}
