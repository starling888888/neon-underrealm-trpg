{
  "name": "@neon-underrealm/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev:local": "wrangler dev --local --persist-to .wrangler/state --port 8787",
    "deploy": "wrangler deploy",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "npm run test:unit && npm run test:workspace-boundary",
    "local:reset": "rm -rf .wrangler/state",
    "migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:integration": "tsx tests/integration.ts",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:workspace-boundary": "tsc --noEmit --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "hono": "^4.13.4"
  }
}
