{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neon-underrealm-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS"
    }
  ],
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBJECTS"
        }
      ]
    }
  }
}
