# Cloudflare Terraform provider token. Do not put this value in a tfvars file.
CLOUDFLARE_API_TOKEN=

# Terraform remote state settings. These are only used by `terraform init`.
TF_STATE_R2_BUCKET_NAME=
TF_STATE_KEY=backend.tfstate
AWS_REGION=auto
AWS_ENDPOINT_URL_S3=https://<cloudflare-account-id>.r2.cloudflarestorage.com
TF_CLI_ARGS_init="-backend-config=bucket=$TF_STATE_R2_BUCKET_NAME -backend-config=key=$TF_STATE_KEY"

# R2 S3-compatible credentials for the Terraform remote state bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
