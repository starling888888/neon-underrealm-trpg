# Cloudflare API token used by Wrangler. Do not commit this value.
CLOUDFLARE_API_TOKEN=

# CORS origins accepted by the development Worker. This comma-separated value is public Worker configuration.
CORS_ALLOW_ORIGIN=http://localhost:4321,http://localhost:4322

# Google Identity Services browser-only credential flow client ID. This is a public value used for ID token audience validation.
GOOGLE_OAUTH_CLIENT_ID=
