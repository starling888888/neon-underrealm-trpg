{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!backend/dist",
      "!backend/.wrangler",
      "!frontend/dist",
      "!node_modules",
      "!.astro",
      "!frontend/.astro",
      "!.dprint-cache",
      "!.tmp",
      "!!frontend/test-results/**",
      "!!frontend/playwright-report/**",
      "!**/*.astro"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
